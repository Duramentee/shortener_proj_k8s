# 后端环境变量示例清单
#
# 重要说明：本文件不会被程序自动读取。后端只从进程的环境变量读取配置，
# 因此本文件的作用是记录「有哪些参数可以调整、默认取值是什么、在什么情况下需要修改」。
#
# 在本地直接运行（go run）时，下面这些取值的默认值已经与 compose.yaml 中的
# PostgreSQL 与 Redis 完全一致，因此一个环境变量都不设置也可以正常启动。
#
# 需要覆盖默认值时，在启动之前把变量导出到当前 shell。zsh 中的做法是：
#   set -a; source .env; set +a
# 其中 .env 是本文件的副本（复制之后把需要的行的注释去掉）。

# HTTP 服务的监听地址。默认值 :8080 表示监听全部网卡的 8080 端口。
# 修改场景：8080 端口已经被占用时。
HTTP_ADDR=:8080

# PostgreSQL 的连接字符串。
# 修改场景：数据库不在本机，或者用户名、口令、数据库名与 compose.yaml 中的取值不同。
DATABASE_URL=postgres://shortener:shortener_dev_password@localhost:5432/shortener?sslmode=disable

# Redis 的连接地址，格式是「主机:端口」。
# 修改场景：Redis 不在本机。
REDIS_ADDR=localhost:6379

# Redis 口令。本地联调的 Redis 没有设置口令，因此默认值是空字符串。
# 修改场景：Redis 开启了 requirepass。
REDIS_PASSWORD=

# Redis 的逻辑数据库编号，取值是 0 到 15。
# 修改场景：同一个 Redis 实例被多个项目共用时，用不同的编号隔离键空间。
REDIS_DB=0

# 短链接缓存键的生存时间。对应 README 第 5 节中 link:{code} 键的 300 秒。
# 修改场景：演示缓存过期与未命中回落时，把它调小到 10s 可以更快看到现象。
CACHE_TTL=300s

# 后台协程把点击增量写回 PostgreSQL 的周期。
# 修改场景：演示写合并时，把它调大可以让 clicks:{code} 键中的增量累积得更明显。
CLICK_FLUSH_INTERVAL=5s

# 收到停止信号之后，等待 HTTP 请求处理完成与写回操作完成的时限。
# 修改场景：一般不需要修改。
SHUTDOWN_TIMEOUT=10s

# gin 的运行模式，可选取值是 debug、release、test。
# debug 模式在启动时打印全部路由清单与每条路由对应的处理函数，便于确认路由注册结果；
# release 模式关闭这些输出并且关闭一部分优化检查。
# 本地联调保持 debug，容器环境中应当设置为 release（api/Dockerfile 中已经设置）。
GIN_MODE=debug
