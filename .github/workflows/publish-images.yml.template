# =============================================================================
# 短链项目 · 镜像发布工作流 · 带注释模板
# =============================================================================
#
# 本文件的用途：给出「把已经在持续集成中通过验证的 main 分支提交构建成镜像并发布到
# GitHub Container Registry」这件事需要写出的每一个片段，并逐项说明这一项的判定条件
# 与写错之后的后果。所有取值一律留空（下方用 ___ 表示），由我本人决定后填写。
#
# 与 ci.yml.template 的分工：
#   ci.yml.template  负责「验证」——判断一次提交能不能与主分支集成，只申请读取权限；
#   本模板           负责「发布」——只在持续集成已经对同一个提交给出成功结论之后才构建并推送镜像。
#
# 使用方式：
#   1. 把下面每一处的 ___ 换成自己决定的取值，然后另存为 publish-images.yml（同一目录）。
#   2. GitHub 只扫描 .github/workflows/ 目录下面的 .yml 与 .yaml 文件，
#      因此本文件（.template 后缀）不会被识别成工作流，也不会出现在仓库的 Actions 页面。
#   3. 提交到特性分支之后开一个拉取请求，先在拉取请求上验证「它不会发布任何镜像」，
#      合并之后再等待持续集成在 main 上成功，最后核对发布工作流与镜像库中的标签。

# name：工作流名称。
#   要填什么：一个能与上游持续集成区分开的名称。
#   判定条件：它只用于显示，取值本身不影响功能。
#   写错的后果：若与上游工作流同名，阅读运行记录时无法分辨哪一次是验证、哪一次是发布。
name: ___

# on：触发条件。
#   这里使用 workflow_run 事件。它监听的是「另一个工作流的运行已经完成」，而不是仓库事件。
#   选用它的理由是：只有在持续集成结束的那一刻，才知道这次验证的结论是成功还是失败。
#   如果把构建与推送直接追加到 ci.yml 的 push 触发里，那么在持续集成尚未给出结论时，
#   镜像就已经被推送出去了。
on:
  workflow_run:
    # workflows：要监听的上游工作流名称。
    #   要填什么：上游工作流的 name 字段取值（注意是 name，不是文件名，也不是路径）。
    #   判定条件：必须与 ci.yml 中 name 字段的取值逐字一致，大小写也要相同。
    #   写错的后果：本工作流永远不会因为上游运行完成而被触发，
    #               而且不会有任何报错提示，表现为「合并之后镜像一直不出现」。
    workflows: [___]

    # types：要监听的事件类型。
    #   要填什么：表示「上游运行已经结束」的那一种类型。
    #   判定条件：上游运行不论成功、失败还是被取消，都要有机会进入下一步判定。
    #   写错的后果：填成其它类型时，上游运行结束时本工作流不会被触发。
    types: [___]

    # branches：要限制的来源分支。
    #   要填什么：上游运行所对应的来源分支。
    #   判定条件：这一层只做初步收窄，精确判定仍然写在下面作业的 if 段里。
    #   写错的后果：省略这一层时，其它分支上的上游运行完成也会进入下一步，
    #               虽然 if 段还会再判断一次，但过滤时机被推迟。
    branches: [___]

# permissions：本次运行申请的权限范围。
#   要填什么：两项——读取仓库内容、以及推送镜像所需的写权限。
#   判定条件：只申请这两个片段真正用到的权限，不多不少。
#   写错的后果：
#     · 缺少读取仓库内容的权限 → checkout 步骤失败；
#     · 缺少推送镜像的写权限   → 推送步骤报权限不足；
#     · 申请了用不到的权限     → 一旦本工作流执行的代码不可信，损失范围随之扩大。
permissions:
  ___: ___
  ___: ___

# concurrency：控制同一时间内的并发执行。
#   要填什么：一个分组名称，以及是否允许打断正在进行的运行。
#   判定条件：分组名称应当包含本次运行对应的提交标识，使不同提交的发布互不顶替。
#   写错的后果：分组取固定值时，两次发布互相顶替；
#               允许打断正在进行的推送时，会留下只推送了一半的中间状态。
concurrency:
  group: ___
  cancel-in-progress: ___

# jobs：作业定义。
jobs:
  # 作业标识符：自己起名，建议能看出职责。
  ___:
    # name：作业的显示名称。
    name: ___

    # if：发布授权的核心判定，多个条件必须**同时**成立。
    #   要填什么：四个条件。
    #     ① 上游运行的结论是不是成功；
    #     ② 上游运行的原始事件类型是不是分支推送；
    #     ③ 上游运行对应的来源分支是不是 main；
    #     ④ 上游工作流名称已经由上面 on.workflow_run.workflows 限定。
    #   判定条件：workflow_run 是高权限触发面，因此不能只凭「某个工作流完成」就获得发布权限。
    #   写错的后果：
    #     · 缺少条件① → 结论为失败的持续集成也会发布镜像；
    #     · 缺少条件② → 拉取请求触发的成功运行也会把未合并的代码发布出去；
    #     · 缺少条件③ → 其它分支上成功的推送也会发布镜像。
    if: ___

    # runs-on：作业使用的执行器。
    #   要填什么：执行这个作业的运行环境。
    #   判定条件：本日范围内只使用 GitHub 托管的执行器，不接入本地集群。
    runs-on: ___

    # env：作业级环境变量。
    #   要填什么：镜像库域名，以及本次运行对应的提交标识。
    #   判定条件：提交标识应当取自「上游运行对应的那一个提交」。
    #   写错的后果：若使用工作流默认提供的那个提交标识，
    #               在上游运行结束之后 main 上又合并了新提交时，
    #               构建的源码与被验证的源码就不是同一个提交。
    env:
      ___: ___
      ___: ___

    steps:
      # 步骤一：检出源码。
      #   要填什么：检出步骤的动作，以及显式指定的检出目标。
      #   判定条件：检出目标必须是上游运行对应的那一个提交。
      #   写错的后果：不显式指定检出目标时，检出的是默认分支的最新提交，
      #               会出现「验证的是 A、构建的是 B」。
      - name: ___
        uses: ___
        with:
          ___: ___

      # 步骤二：把镜像命名空间转换成小写（按需保留）。
      #   要填什么：把所有者名称转成小写并写入环境文件的那一条命令。
      #   判定条件：镜像库要求镜像路径中的命名空间全部使用小写字母。
      #   写错的后果：所有者登录名含大写字母时，推送会因路径非法而失败。
      - name: ___
        run: ___

      # 步骤三：登录镜像库。
      #   要填什么：登录命令，以及凭据的来源与传入方式。
      #   判定条件：使用运行期间自动签发的短期凭据，并且凭据内容不出现在命令行与日志中。
      #   写错的后果：把长期凭据写进仓库会带来轮换与撤销成本；
      #               用命令行参数直接传凭据会让凭据内容出现在日志里。
      - name: ___
        run: ___

      # 步骤四：构建并推送后端镜像。
      #   要填什么：构建上下文、Dockerfile 路径、镜像名称与标签。
      #   判定条件：标签使用不可变的提交标识；构建上下文的目录名以 api 结尾。
      #   写错的后果：标签使用浮动取值时会被后续推送覆盖，无法从标签回溯到源码提交；
      #               构建上下文指错时，多阶段构建会因找不到依赖清单而失败。
      - name: ___
        run: ___

      # 步骤五：构建并推送前端镜像。
      #   要填什么：与上一步相同的一组取值，注意构建上下文与 Dockerfile 路径改为前端。
      #   判定条件：两个镜像使用各自独立的包名与同一套标签规则。
      #   写错的后果：两个镜像共用同一个包名时，后推送的会覆盖前一个。
      - name: ___
        run: ___
